from machine import Pin, PWM, ADC
from time import sleep, ticks_ms


def logger(pins, sample_interval, log_file_path, motor_running):
    adcs = []
    for p in pins:
        a = ADC(Pin(p))
        a.atten(ADC.ATTN_11DB)
        adcs.append((p, a))

    start_time = ticks_ms()

    with open(log_file_path, "a") as f:
        while motor_running:
            t_elapsed = ticks_ms() - start_time
            readings = [f"t:{t_elapsed}"]

            for p, a in adcs:
                uv = a.read_uv()
                volts = uv / 1_000_000.0
                readings.append(f"P{p}:{volts:.3f}V")

            line = "\t".join(readings)
            print(line)
            f.write(line + "\n")
            f.flush()

            sleep(sample_interval)
    return
