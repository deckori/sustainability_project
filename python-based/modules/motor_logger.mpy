from voltmeter.mpy import logger
import _thread

motor_running = True


if __name__ == "__main__":
    motor_log = "motor_turns.txt"
    adc_log = "adc_readings.txt"
    target_pins = [
        4,  # GND
        0,  # Vcc
        2,  # L_EN
        15,  # R_EN
        12,  # RPWM
        13,  # LPWM
    ]

    # Clear or initialize log files at startup
    with open(motor_log, "w") as f:
        f.write("Time(ms)\tState\n")

    with open(adc_log, "w") as f:
        f.write("Time(ms)\tReadings...\n")

    # Start motor control loop on background thread
    _thread.start_new_thread(turn, (2, motor_log))

    # Run multi-pin ADC logger on main thread
    logger(target_pins, 0.2, adc_log)
