from machine import Pin, PWM, ADC
from time import sleep, ticks_ms


def turn(sleep_time):
    # Initialize motor driver pins and PWM frequency (1 kHz)
    RPWM = PWM(Pin(25), freq=1000)
    LPWM = Pin(26, Pin.OUT)
    EN = Pin(27, Pin.OUT)

    PWM = RPWM
    direction = LPWM

    def motor_turn(state, speed=38588, enable=1):
        # Motor speed value mapped to MicroPython's 16-bit PWM range (0 - 65535)
        # A value of 38588 roughly corresponds to ~60% speed.
        PWM.duty_u16(speed)
        direction.value(state)
        EN.value(enable)

    def stop_motor():
        # Cuts all power and disables the motor driver
        motor_turn(state=0, enable=0)

    # Initial system stop and startup delay
    stop_motor()
    sleep(1)

    start_time = ticks_ms()

    while True:
        print("CLOCKWISE")

        t_clock = ticks_ms() - start_time
        print(f"{t_clock}\tCLOCKWISE")
        f.write(f"{t_clock}\tCLOCKWISE\n")
        f.flush()

        motor_turn(state=1)
        sleep(sleep_time)

        print("STOP")

        t_stop1 = ticks_ms() - start_time
        print(f"{t_stop1}\tSTOP")
        f.write(f"{t_stop1}\tSTOP\n")
        f.flush()

        stop_motor()
        sleep(sleep_time)

        print("ANTICLOCKWISE")

        t_anticlock = ticks_ms() - start_time
        print(f"{t_anticlock}\tANTICLOCKWISE")
        f.write(f"{t_anticlock}\tANTICLOCKWISE\n")
        f.flush()

        motor_turn(state=1)
        sleep(sleep_time)

        print("STOP")

        t_stop2 = ticks_ms() - start_time
        print(f"{t_stop2}\tSTOP")
        f.write(f"{t_stop2}\tSTOP\n")
        f.flush()

        stop_motor()
        sleep(sleep_time)

        # print("REPEATING LOOP")
        global motor_running
        motor_running = False
        break

        return motor_running
